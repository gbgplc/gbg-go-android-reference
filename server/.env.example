# GBG Go API Credentials
# Obtain these from your GBG account representative or the GBG Go portal.
GO_CLIENT_ID=your-client-id
GO_CLIENT_SECRET=your-client-secret
GO_USERNAME=api-user@example.com
GO_PASSWORD=your-password

# Regional server index: 0 = EU, 1 = US, 2 = AU.
# Selects the prod regional server when GO_SERVER_URL is left unset.
GO_SERVER_IDX=0

# Default resource ID for journeys
GO_RESOURCE_ID=your-resource-id@latest

# Captain API base URL (optional). Set this only to target a custom or
# nonprod environment (e.g. a demo fabric host); include the /v2/captain
# suffix. When set it overrides GO_SERVER_IDX. Omit it to use the regional
# prod server chosen by GO_SERVER_IDX.
# GO_SERVER_URL=https://your-environment.example.com/v2/captain

# Token endpoint base URL (optional). The token endpoint is GBG's central
# auth service and is independent of region and of GO_SERVER_URL. Leave unset
# for prod (https://api.auth.gbgplc.com). When GO_SERVER_URL is set and this is
# not, the server defaults to the nonprod auth service
# (https://test-api.auth.gbgplc.com). Host only; the SDK appends the path.
# GO_AUTH_URL=https://test-api.auth.gbgplc.com

# Server port (default: 3000)
PORT=3000
