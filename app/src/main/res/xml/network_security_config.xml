<?xml version="1.0" encoding="utf-8"?>
<!--
  Release-safe config: cleartext traffic is allowed only for emulator/loopback
  hosts so the demo can reach a companion server on the developer's Mac
  (10.0.2.2 from the emulator) and the bridge-demo app at http://10.0.2.2:11000.

  For physical-device LAN testing (e.g. http://192.168.x.x:3000), debug builds
  override this file via app/src/debug/res/xml/network_security_config.xml,
  which permits cleartext to any host. Production APKs ship this file as-is.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
  </domain-config>
</network-security-config>
