<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config. This file lives in the `debug` source
  set, so it replaces the main `network_security_config.xml` only when the
  app is built with the debug build type — release APKs ship the locked-down
  main version.

  Cleartext is permitted to ANY host here so developers can point the Setup
  screen at a companion server running on a LAN IP (e.g. http://192.168.x.x:3000)
  when testing on a physical device. The 10.0.2.2 / localhost loopback
  allowlist in the main config is sufficient for the emulator but doesn't
  cover physical-device LAN testing.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
</network-security-config>
